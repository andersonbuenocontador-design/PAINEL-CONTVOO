# Copie para .env.local e preencha. NUNCA versionar segredos reais.
DATABASE_URL=postgres://usuario:senha@localhost:5432/painel
# Gere com: openssl rand -base64 48
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Usados apenas pelo comando "npm run seed" para criar o primeiro administrador
SEED_ADMIN_EMAIL=admin@seuescritorio.com.br
SEED_ADMIN_PASSWORD="defina-uma-senha-forte"  # use aspas se a senha tiver #
# URL pública do painel (usada nos links dos e-mails de aviso)
APP_URL=https://painel.seuescritorio.com.br
# E-mails de aviso (opcional; sem isso os avisos ficam na fila): smtp://usuario:senha@servidor:587
#EMAIL_PROVIDER=smtp
SMTP_URL=
EMAIL_FROM="Contvoo Contabilidade <avisos@seuescritorio.com.br>"
# Segredo (mín. 24 caracteres) para o agendador chamar POST /api/notificacoes/processar
CRON_SECRET=

# --- Segurança e operação (veja docs/IMPLANTACAO.md) ---
# Chave própria para cifrar o segredo do 2FA (mín. 32 caracteres, diferente da SESSION_SECRET). Guarde junto dos backups.
APP_ENCRYPTION_KEY=
# Exige 2FA para administradores
EXIGIR_2FA_ADMIN=1
# Defina 1 somente atrás de UM proxy reverso confiável que sobrescreve X-Forwarded-For
TRUST_PROXY=
# Pasta dos arquivos enviados (privada, fora de public/)
STORAGE_DIR=./storage
# Prazo de guarda dos arquivos, em anos (defina com o jurídico/encarregado)
RETENCAO_ANOS=5
# Backup (npm run backup): senha que cifra os backups (guarde fora do servidor), pasta e quantos conjuntos manter
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
BACKUP_KEEP=14
